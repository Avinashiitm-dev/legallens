# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database (Google Cloud SQL for PostgreSQL / local Postgres) ──
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<CLOUD_SQL_IP_OR_PROXY>:5432/<DB_NAME>"

# ── Firebase (client-side — exposed to browser via Vite) ────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Firebase (server-side) ──────────────────────────────────────
# Firebase Admin SDK auto-detects credentials on GCP.
# For local dev, set GOOGLE_APPLICATION_CREDENTIALS to a service-account key JSON.
FIREBASE_PROJECT_ID=      # Same as VITE_FIREBASE_PROJECT_ID

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Firebase UID of the app creator; this user gets role "admin" on first login

# ── AI Gateway (server-side only — never expose to the browser) ──
LEGALLENS_AI_BASE_URL=    # Platform AI gateway entry
LEGALLENS_AI_API_KEY=     # Platform gateway credential; powers analysis & chat

# ── Object Storage (original uploaded binaries) ─────────────────
LEGALLENS_STORAGE_RESOURCE_ID= # Platform storage resource id for this site

# ── Document Processing Limits (defaults in contracts/constants.ts) ─
# MAX_UPLOAD_MB=15
# MAX_EXTRACT_CHARS=120000
# MAX_PDF_PAGES=300
